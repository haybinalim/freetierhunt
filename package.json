{
  "name": "freetierhunt",
  "version": "0.1.0",
  "private": true,
  "description": "Aggregator for AI tool free tiers, trials, and promo codes",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/lib/db/seed.ts",
    "test:llm": "tsx --env-file=.env.local scripts/test-llm.ts",
    "worker:dev": "tsx watch --env-file=.env.local worker/index.ts",
    "worker:start": "pm2 start ecosystem.config.cjs",
    "worker:stop": "pm2 stop freetierhunt-worker",
    "worker:logs": "pm2 logs freetierhunt-worker",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.50.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.0",
    "lodash-es": "^4.17.21",
    "next": "^15.0.0",
    "openai": "^6.34.0",
    "p-map": "^7.0.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "slugify": "^1.6.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "pino-pretty": "^11.3.0",
    "pm2": "^5.4.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,css,yml,yaml}": "prettier --write"
  }
}
