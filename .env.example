# =================================================================
# FreeTierHunt — Environment Variables
# Copy this file to .env.local and fill values from your password vault
# NEVER commit .env or .env.local
# =================================================================

# --- Application ---
NODE_ENV=development
SITE_URL=http://localhost:3000
TZ=UTC

# --- Database (Supabase Postgres) ---
# Pooler URL (port 6543) — for app runtime queries
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct URL (port 5432) — for drizzle-kit migrations only
DIRECT_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx_SERVICE_ROLE_NEVER_EXPOSE_TO_CLIENT

# --- Redis (Oracle VM or Upstash) ---
REDIS_URL=redis://default:PASSWORD@your-oracle-vm:6379

# --- LLM Providers (router fallback chain) ---
GROQ_API_KEY=gsk_xxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENAI_API_KEY=sk-proj-xxxxx
NVIDIA_NIM_API_KEY=nvapi-xxxxx

# --- Data Sources ---
PH_API_KEY=xxxxx
PH_API_SECRET=xxxxx
FIRECRAWL_API_KEY=fc-xxxxx

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxx
RESEND_FROM_EMAIL=hello@freetierhunt.com

# --- Monitoring ---
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=sntrys_xxxxx
SENTRY_ORG=freetierhunt
SENTRY_PROJECT=freetierhunt-web

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Webhooks / Alerts ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx
REVALIDATE_SECRET=long_random_string_for_isr_revalidation

# --- Forms ---
NEXT_PUBLIC_TALLY_FORM_ID=xxxxx
